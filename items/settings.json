  {
    "name": "Swift Sail",
    "type": "composite_toggle",
    "codes": "composite_sail",
    "item_left": "swift_sail",
    "item_right": "sail",
    "images": [
      // Is not Swift
      {
        "left": false,
        "right": false,
        "img": "images/items/sail.png",
        "img_mods": "@disabled"
      },
      {
        "left": false,
        "right": true,
        "img": "images/items/sail.png"
      },
      // Is Swift
      {
        "left": true,
        "right": false,
        "img": "images/items/sail_swift.png",
        "img_mods": "@disabled"
      },
      {
        "left": true,
        "right": true,
        "img": "images/items/sail_swift.png"
      }
    ]
  },

